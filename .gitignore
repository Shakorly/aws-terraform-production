# Terraform working directory and downloaded providers
**/.terraform/*

# Terraform state: may contain sensitive information
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Local variable files: do not commit environment-specific values
terraform.tfvars
terraform.tfvars.json
*.secret.tfvars
*.secret.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration and local credentials
.terraformrc
terraform.rc

# OS/editor noise
.DS_Store
*.swp
*.swo

# Saved plan files can contain sensitive values
*.tfplan
tfplan
